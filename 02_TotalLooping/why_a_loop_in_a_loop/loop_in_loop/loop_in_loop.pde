/// Loop in loop. The role of code blocks (made by curly braces {}).
//-//////////////////////////////////////////////////////////////////

for(int i=0;i<10;i++)
{
  for(int j=0;j<10;j++)
  {
    println(i,j); // Console printout
  }
}

